{
  "$scope": "Partition of three sibling repos: phenix.ui (TS monorepo), phenix.yard and phenix.appointments (Spring Boot). Paths are relative to architecture-map/. Dotdirs (.github, .storybook), build files (pom.xml, Dockerfile), docs and generated build output are outside `sources` by design. USCS v1, Keycloak, Azure Service Bus and the other Phenix services are unmeasured outside-world nodes and claim nothing.",

  "ui-shell": {
    "owns": ["../phenix.ui/apps/shell/**"]
  },
  "ui-bff": {
    "owns": ["../phenix.ui/apps/shell/src/app/ui-bff/**"]
  },
  "ui-yard-app": {
    "owns": ["../phenix.ui/apps/yard/**"]
  },
  "ui-appointments-app": {
    "owns": ["../phenix.ui/apps/appointments/**"]
  },
  "ui-transaction-app": {
    "owns": ["../phenix.ui/apps/transaction-history/**"]
  },
  "ui-kit": {
    "owns": ["../phenix.ui/packages/ui/**", "../phenix.ui/packages/shell-ui/**"]
  },
  "ui-form-engine": {
    "owns": ["../phenix.ui/packages/form-engine/**"]
  },
  "ui-session-auth": {
    "owns": [
      "../phenix.ui/packages/session/**",
      "../phenix.ui/packages/auth/**",
      "../phenix.ui/packages/preferences/**",
      "../phenix.ui/packages/logging/**",
      "../phenix.ui/apps/shell/src/proxy.ts"
    ]
  },
  "ui-workshop": {
    "owns": [
      "../phenix.ui/scripts/**",
      "../phenix.ui/generators/**",
      "../phenix.ui/e2e/**",
      "../phenix.ui/wallaby/**",
      "../phenix.ui/*.ts",
      "../phenix.ui/*.js",
      "../phenix.ui/*.cjs",
      "../phenix.ui/packages/eslint-config/**",
      "../phenix.ui/packages/typescript-config/**",
      "../phenix.ui/packages/vitest-config/**",
      "../phenix.ui/packages/storybook-config/**",
      "../phenix.ui/packages/storybook-check/**",
      "../phenix.ui/packages/storybook/**"
    ]
  },

  "yard-core": {
