      "../phenix.yard/src/main/java/com/uscs/phenix/yard/driver/**",
      "../phenix.yard/src/main/java/com/uscs/phenix/yard/warehouse/**",
      "../phenix.yard/src/main/java/com/uscs/phenix/yard/carriers/**",
      "../phenix.yard/src/main/java/com/uscs/phenix/yard/yardspot/**",
      "../phenix.yard/src/main/java/com/uscs/phenix/yard/dockdoor/**",
      "../phenix.yard/src/main/java/com/uscs/phenix/yard/arrival/**",
      "../phenix.yard/src/main/java/com/uscs/phenix/yard/loadprogress/**",
