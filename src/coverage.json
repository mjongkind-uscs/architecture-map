      "../phenix.appointments/src/main/resources/db/**",
      "../phenix.appointments/src/main/resources/*.yaml",
      "../phenix.appointments/src/main/resources/*.yml",
      "../phenix.appointments/src/main/resources/*.properties",
      "../phenix.appointments/src/main/resources/*.xml"
    ]
